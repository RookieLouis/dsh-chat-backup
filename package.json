{
  "name": "dsh-chat-backup",
  "version": "0.2.2",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/RookieLouis/dsh-chat-backup.git" },
  "homepage": "https://github.com/RookieLouis/dsh-chat-backup#readme",
  "bugs": { "url": "https://github.com/RookieLouis/dsh-chat-backup/issues" },
  "private": true,
  "type": "module",
  "description": "Incremental, verified DSH conversation backups with immutable history and safe restore.",
  "main": "./lib/index.js",
  "exports": { ".": "./lib/index.js", "./backup": "./lib/backup.js", "./client": "./lib/client.js", "./package.json": "./package.json" },
  "files": ["lib", "src", "tools", "tests", "cordis.patch.yml", "README.md", "LICENSE"],
  "scripts": { "build": "node tools/build-client.mjs", "test": "node --test tests/*.test.mjs", "backup": "node tools/cli.mjs backup", "list": "node tools/cli.mjs list" },
  "engines": { "node": ">=22.19.0" },
  "peerDependencies": {
    "@deepseek-ai/dsh-launch-environment": "0.2.0-rc.1 || 0.2.0-rc.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.1 || 0.2.0-rc.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.1 || 0.2.0-rc.2 || 0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web", "immediately": true,
      "inject": ["@deepseek-ai/dsh-api-gateway", "@deepseek-ai/dsh-client-ui-renderer", "@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-client-ui-workspace", "@deepseek-ai/dsh-client-ui-plugin-manager"]
    }
  }
}
